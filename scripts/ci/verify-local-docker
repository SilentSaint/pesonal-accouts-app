#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
DOCKERFILE_RELATIVE="ci/local-verification/Dockerfile"
DOCKERFILE_PATH="$ROOT_DIR/$DOCKERFILE_RELATIVE"
IMAGE_NAME="${LOCAL_VERIFICATION_IMAGE:-automatic-expense-tracker-ci:local}"
BUILD_IMAGE=1
PULL_IMAGE=0
PRINT_CONFIG=0
GIT_DIR="${GIT_DIR:-}"
GIT_COMMON_DIR="${GIT_COMMON_DIR:-}"

usage() {
  cat <<'USAGE'
Usage: scripts/ci/verify-local-docker [options]

Build the pinned local validation image and run the complete verification lane
inside it. The repository is mounted read-write so build and test artifacts
remain available locally.

Options:
  --no-build       Reuse the local image instead of building it.
  --pull           Ask Docker to pull a newer base image during the build.
  --image NAME     Use NAME instead of automatic-expense-tracker-ci:local.
  --print-config   Print the safety and reproducibility contract, then exit.
  -h, --help       Show this help.
USAGE
}

print_config() {
  cat <<CONFIG
Dockerfile: $DOCKERFILE_RELATIVE
Image: $IMAGE_NAME
Toolchain: Java 21, Node 20.20.2, Flutter 3.44.0, Terraform 1.5.7, Playwright 1.47.2
AWS credential injection: disabled
AWS metadata access: disabled
Terraform mutation: validation only
Verification command: scripts/ci/verify
Git directory: ${GIT_DIR:-unresolved}
Git common directory: ${GIT_COMMON_DIR:-unresolved}
Git metadata mount: read-only
CONFIG
}

while (($# > 0)); do
  case "$1" in
    --no-build)
      BUILD_IMAGE=0
      shift
      ;;
    --pull)
      PULL_IMAGE=1
      shift
      ;;
    --image)
      if (($# < 2)); then
        echo "--image requires a value" >&2
        exit 64
      fi
      IMAGE_NAME="$2"
      shift 2
      ;;
    --print-config)
      PRINT_CONFIG=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

if ! GIT_DIR="$(git -C "$ROOT_DIR" rev-parse --absolute-git-dir 2>/dev/null)"; then
  echo "The local verification path must run from a Git checkout or worktree." >&2
  exit 1
fi
if ! GIT_COMMON_DIR="$(git -C "$ROOT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  echo "Unable to resolve the Git common directory for the local checkout." >&2
  exit 1
fi

if ((PRINT_CONFIG)); then
  print_config
  exit 0
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required for local container verification." >&2
  exit 127
fi

if [[ ! -f "$DOCKERFILE_PATH" ]]; then
  echo "Missing local verification Dockerfile: $DOCKERFILE_PATH" >&2
  exit 1
fi

if ((BUILD_IMAGE)); then
  build_args=(build --tag "$IMAGE_NAME" --file "$DOCKERFILE_PATH")
  if ((PULL_IMAGE)); then
    build_args+=(--pull)
  fi
  docker "${build_args[@]}" "$ROOT_DIR"
fi

docker run --rm --init \
  --security-opt no-new-privileges:true \
  --user "$(id -u):$(id -g)" \
  --workdir /workspace \
  --volume "$ROOT_DIR:/workspace" \
  --volume "$GIT_COMMON_DIR:$GIT_COMMON_DIR:ro" \
  --env CI=1 \
  --env HOME=/tmp/aet-ci-home \
  --env AWS_ACCESS_KEY_ID= \
  --env AWS_SECRET_ACCESS_KEY= \
  --env AWS_SESSION_TOKEN= \
  --env AWS_SECURITY_TOKEN= \
  --env AWS_PROFILE= \
  --env AWS_CONFIG_FILE=/dev/null \
  --env AWS_SHARED_CREDENTIALS_FILE=/dev/null \
  --env AWS_EC2_METADATA_DISABLED=true \
  "$IMAGE_NAME" \
  bash -euo pipefail -c '
    mkdir -p "$HOME"
    git config --global --add safe.directory /workspace
    exec ./scripts/ci/verify
  '
