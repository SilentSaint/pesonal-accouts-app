#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
ORIGINAL_ARGS=("$@")
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/../.." && pwd)"
DOCKERFILE_RELATIVE="ci/local-verification/Dockerfile"
DOCKERFILE_PATH="$ROOT_DIR/$DOCKERFILE_RELATIVE"
IMAGE_NAME="${LOCAL_VERIFICATION_IMAGE:-automatic-expense-tracker-ci:local}"
CACHE_DIR="${LOCAL_VERIFIER_CACHE_DIR:-$(dirname "$ROOT_DIR")/.automatic-expense-tracker-local-verification-cache}"
DOCKER_BIN="${LOCAL_VERIFIER_DOCKER_BIN:-docker}"
MIN_CACHE_FREE_MB="${LOCAL_VERIFIER_MIN_CACHE_FREE_MB:-2048}"
MAX_CACHE_FREE_MB=9223372036854775807
RETRY_ATTEMPTS="${LOCAL_VERIFIER_RETRY_ATTEMPTS:-3}"
RETRY_DELAY_SECONDS="${LOCAL_VERIFIER_RETRY_DELAY_SECONDS:-2}"
BUILD_IMAGE=1
PULL_IMAGE=0
PRINT_CONFIG=0
PREFLIGHT_ONLY=0
LOG_FILE=""
GIT_DIR="${GIT_DIR:-}"
GIT_COMMON_DIR="${GIT_COMMON_DIR:-}"
SOURCE_REVISION=""
SNAPSHOT_DIR=""

usage() {
  cat <<'USAGE'
Usage: scripts/ci/verify-local-docker [options]

Build the pinned local validation image and run the complete verification lane
inside it. A detached worktree snapshot of HEAD is mounted read-write so build
and test artifacts remain isolated from the invoking checkout.

Options:
  --no-build       Reuse the local image instead of building it.
  --pull           Ask Docker to pull a newer base image during the build.
  --image NAME     Use NAME instead of automatic-expense-tracker-ci:local.
  --cache-dir DIR  Store dependency caches on DIR instead of the default sibling cache.
  --log-file FILE  Copy container output to FILE.
  --preflight-only Check Git, storage, and Docker access without building or running.
  --print-config   Print the safety and reproducibility contract, then exit.
  -h, --help       Show this help.
USAGE
}

cache_free_mb() {
  local available_kb
  available_kb="$(df -Pk "$CACHE_DIR" 2>/dev/null | awk 'NR == 2 {print $4}')"
  if [[ "$available_kb" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$((available_kb / 1024))"
  else
    return 1
  fi
}

print_config() {
  cat <<CONFIG
Dockerfile: $DOCKERFILE_RELATIVE
Image: $IMAGE_NAME
Toolchain: Java 21, Node 20.20.2, Flutter 3.44.0, Terraform 1.5.7, Playwright 1.47.2
Verification source: detached worktree snapshot of HEAD
Cache directory: $CACHE_DIR
Minimum cache free space: ${MIN_CACHE_FREE_MB} MB
Dependency cache mounts: Gradle, Terraform, Flutter pub, npm
Terraform cache policy: per-run data and provider-cache lock during init only
Retry policy: ${RETRY_ATTEMPTS} attempt(s), ${RETRY_DELAY_SECONDS}s linear backoff
AWS credential injection: disabled
AWS IMDS credential lookup: disabled (no network-level block)
Terraform mutation: validation only
Docker access: preflighted before image build or container run
Verification command: scripts/ci/verify-local
Git directory: ${GIT_DIR:-unresolved}
Git common directory: ${GIT_COMMON_DIR:-unresolved}
Git metadata mount: read-only
CONFIG
}

while (($# > 0)); do
  case "$1" in
    --no-build)
      BUILD_IMAGE=0
      shift
      ;;
    --pull)
      PULL_IMAGE=1
      shift
      ;;
    --image)
      if (($# < 2)); then
        echo "--image requires a value" >&2
        exit 64
      fi
      IMAGE_NAME="$2"
      shift 2
      ;;
    --cache-dir)
      if (($# < 2)); then
        echo "--cache-dir requires a path" >&2
        exit 64
      fi
      CACHE_DIR="$2"
      shift 2
      ;;
    --log-file)
      if (($# < 2)); then
        echo "--log-file requires a path" >&2
        exit 64
      fi
      LOG_FILE="$2"
      shift 2
      ;;
    --print-config)
      PRINT_CONFIG=1
      shift
      ;;
    --preflight-only)
      PREFLIGHT_ONLY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 64
      ;;
  esac
done

if ! [[ "$MIN_CACHE_FREE_MB" =~ ^[0-9]+$ ]]; then
  echo "LOCAL_VERIFIER_MIN_CACHE_FREE_MB must be a non-negative integer." >&2
  exit 64
fi
normalized_min_cache_free_mb="${MIN_CACHE_FREE_MB#"${MIN_CACHE_FREE_MB%%[!0]*}"}"
if [[ -z "$normalized_min_cache_free_mb" ]]; then
  normalized_min_cache_free_mb=0
fi
MIN_CACHE_FREE_MB="$normalized_min_cache_free_mb"
min_cache_free_exceeds_max=0
if (( ${#MIN_CACHE_FREE_MB} > ${#MAX_CACHE_FREE_MB} )); then
  min_cache_free_exceeds_max=1
elif (( ${#MIN_CACHE_FREE_MB} == ${#MAX_CACHE_FREE_MB} )) &&
  [[ "$MIN_CACHE_FREE_MB" > "$MAX_CACHE_FREE_MB" ]]; then
  min_cache_free_exceeds_max=1
fi
if (( min_cache_free_exceeds_max )); then
  echo "LOCAL_VERIFIER_MIN_CACHE_FREE_MB must be between 0 and $MAX_CACHE_FREE_MB." >&2
  exit 64
fi
if ! [[ "$RETRY_ATTEMPTS" =~ ^[0-9]+$ ]] ||
  ! [[ "$RETRY_DELAY_SECONDS" =~ ^[0-9]+$ ]]; then
  echo "LOCAL_VERIFIER_RETRY_ATTEMPTS must be positive and LOCAL_VERIFIER_RETRY_DELAY_SECONDS must be non-negative." >&2
  exit 64
fi
normalized_retry_attempts="${RETRY_ATTEMPTS#"${RETRY_ATTEMPTS%%[!0]*}"}"
if [[ -z "$normalized_retry_attempts" ]]; then
  normalized_retry_attempts=0
fi
RETRY_ATTEMPTS="$normalized_retry_attempts"
if ! [[ "$RETRY_ATTEMPTS" =~ ^[1-9][0-9]*$ ]]; then
  echo "LOCAL_VERIFIER_RETRY_ATTEMPTS must be a positive decimal integer." >&2
  exit 64
fi

ROOT_REAL_DIR="$(cd "$ROOT_DIR" && pwd -P)"
if [[ "$CACHE_DIR" != /* ]]; then
  CACHE_DIR="$(dirname "$ROOT_REAL_DIR")/$CACHE_DIR"
fi
if ! command -v realpath >/dev/null 2>&1; then
  echo "The local verification cache requires the host 'realpath' command." >&2
  echo "Install coreutils or use a host that provides realpath before retrying." >&2
  exit 126
fi
if ! CACHE_DIR="$(realpath -m -- "$CACHE_DIR")"; then
  echo "Unable to resolve the local verification cache path: $CACHE_DIR" >&2
  exit 1
fi
case "$CACHE_DIR" in
  "$ROOT_REAL_DIR"|"$ROOT_REAL_DIR"/*)
    echo "The local verification cache must be outside the checkout: $CACHE_DIR" >&2
    echo "Use --cache-dir PATH outside $ROOT_REAL_DIR." >&2
    exit 1
    ;;
esac
if [[ -n "$LOG_FILE" ]]; then
  if ! LOG_FILE="$(realpath -m -- "$LOG_FILE")"; then
    echo "Unable to resolve the local verification log path: $LOG_FILE" >&2
    exit 1
  fi
  case "$LOG_FILE" in
    "$ROOT_REAL_DIR"|"$ROOT_REAL_DIR"/*)
      echo "The local verification log must be outside the checkout: $LOG_FILE" >&2
      echo "Use --log-file PATH outside $ROOT_REAL_DIR." >&2
      exit 1
      ;;
  esac
fi

if ! GIT_DIR="$(git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" rev-parse --absolute-git-dir 2>/dev/null)"; then
  echo "The local verification path must run from a Git checkout or worktree." >&2
  exit 1
fi
if ! GIT_COMMON_DIR="$(git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  echo "Unable to resolve the Git common directory for the local checkout." >&2
  exit 1
fi

if [[ -n "$LOG_FILE" ]]; then
  mkdir -p "$(dirname "$LOG_FILE")"
  exec > >(tee "$LOG_FILE") 2>&1
fi

if ((PRINT_CONFIG)); then
  print_config
  exit 0
fi

prepare_cache() {
  if ! mkdir -p "$CACHE_DIR"; then
    echo "Unable to create the local verification cache directory: $CACHE_DIR" >&2
    echo "Choose a writable path with --cache-dir PATH." >&2
    exit 1
  fi
  if [[ ! -d "$CACHE_DIR" || ! -w "$CACHE_DIR" ]]; then
    echo "Local verification cache is not writable: $CACHE_DIR" >&2
    echo "Choose a writable path with --cache-dir PATH." >&2
    exit 1
  fi
  local cache_path
  local -a mounted_cache_paths=(
    "$CACHE_DIR/gradle"
    "$CACHE_DIR/terraform"
    "$CACHE_DIR/terraform/plugin-cache"
    "$CACHE_DIR/flutter"
    "$CACHE_DIR/flutter/pub-cache"
    "$CACHE_DIR/npm"
  )
  for cache_path in "${mounted_cache_paths[@]}"; do
    if ! mkdir -p "$cache_path"; then
      echo "Unable to create a local verification cache directory: $cache_path" >&2
      echo "Choose a writable path with --cache-dir PATH." >&2
      exit 1
    fi
    if [[ ! -d "$cache_path" || ! -w "$cache_path" ]]; then
      echo "Local verification cache subdirectory is not writable: $cache_path" >&2
      echo "Choose a writable path with --cache-dir PATH." >&2
      exit 1
    fi
  done
  local terraform_lock_file="$CACHE_DIR/terraform/plugin-cache.lock"
  if ! { : >> "$terraform_lock_file"; } 2>/dev/null ||
    [[ ! -f "$terraform_lock_file" || ! -w "$terraform_lock_file" ]]; then
    echo "Terraform provider-cache lock file is not writable: $terraform_lock_file" >&2
    echo "Choose a writable path with --cache-dir PATH." >&2
    exit 1
  fi
  local available_mb
  available_mb="$(cache_free_mb || true)"
  if [[ -z "$available_mb" ]]; then
    echo "Unable to measure free space for the local verification cache: $CACHE_DIR" >&2
    exit 1
  fi
  if ((available_mb < MIN_CACHE_FREE_MB)); then
    echo "Local verification cache has only ${available_mb} MB free; ${MIN_CACHE_FREE_MB} MB is required before starting." >&2
    echo "Use --cache-dir PATH on a filesystem with more free space." >&2
    exit 1
  fi
  echo "Cache directory: $CACHE_DIR (${available_mb} MB free)"
}

docker_access_preflight() {
  if ! command -v "$DOCKER_BIN" >/dev/null 2>&1; then
    echo "Docker access preflight failed: '$DOCKER_BIN' is not available." >&2
    echo "Install Docker or set LOCAL_VERIFIER_DOCKER_BIN to its executable path." >&2
    exit 126
  fi

  if "$DOCKER_BIN" info >/dev/null 2>&1; then
    echo "Docker access preflight passed."
    return 0
  fi

  if [[ "${LOCAL_VERIFIER_DOCKER_GROUP_REEXEC:-}" != "1" ]]; then
    account_groups="$(id -nG "$(id -un)" 2>/dev/null || true)"
    process_groups="$(id -nG 2>/dev/null || true)"
    if [[ " $account_groups " == *" docker "* ]] &&
      [[ " $process_groups " != *" docker "* ]] &&
      command -v sg >/dev/null 2>&1; then
      if sg docker -c "$DOCKER_BIN info" >/dev/null 2>&1; then
        command_line=""
        printf -v quoted_script '%q' "$SCRIPT_PATH"
        command_line="$quoted_script"
        for arg in "${ORIGINAL_ARGS[@]}"; do
          printf -v quoted_arg '%q' "$arg"
          command_line+=" $quoted_arg"
        done
        echo "Current process lacks the Docker group; re-running under the account's Docker membership." >&2
        export LOCAL_VERIFIER_DOCKER_GROUP_REEXEC=1
        exec sg docker -c "$command_line"
      fi
      echo "Docker access preflight failed: the account is in the docker group, but this process cannot acquire it." >&2
      echo "Start a new login session or run from a session with Docker group membership; do not retry the full gate blindly." >&2
      exit 126
    fi
  fi

  echo "Docker access preflight failed: the Docker daemon is unavailable or permission was denied." >&2
  echo "Start Docker and ensure this process can run '$DOCKER_BIN info' before retrying." >&2
  exit 126
}

dependency_network_preflight() {
  local endpoint
  local -a curl_args=(
    --fail --head --location --silent --show-error
    --connect-timeout 3 --max-time 8
    --output /dev/null
  )
  local -a endpoints=(
    "https://public.ecr.aws/"
    "https://archive.ubuntu.com/ubuntu/"
    "https://security.ubuntu.com/ubuntu/"
    "https://apt.corretto.aws/corretto.key"
    "https://nodejs.org/dist/"
    "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.44.0-stable.tar.xz"
    "https://services.gradle.org/distributions/gradle-8.7-bin.zip"
    "https://repo.maven.apache.org/maven2/"
    "https://registry.terraform.io/.well-known/terraform.json"
    "https://releases.hashicorp.com/"
    "https://pub.dev/"
    "https://registry.npmjs.org/"
  )
  # Chromium revision 1134 is pinned by Playwright 1.47.2 in the Dockerfile.
  local -a playwright_cdns=(
    "https://playwright.azureedge.net/builds/chromium/1134/chromium-linux.zip"
    "https://playwright-akamai.azureedge.net/builds/chromium/1134/chromium-linux.zip"
    "https://playwright-verizon.azureedge.net/builds/chromium/1134/chromium-linux.zip"
  )
  local playwright_cdn_available=0

  if ! command -v curl >/dev/null 2>&1; then
    echo "Dependency network preflight cannot run: curl is required on the host." >&2
    echo "Install curl, or use a host with curl and outbound HTTPS access." >&2
    exit 1
  fi

  for endpoint in "${endpoints[@]}"; do
    if ! curl "${curl_args[@]}" "$endpoint" >/dev/null 2>&1; then
      echo "Dependency network preflight failed: unable to reach $endpoint." >&2
      echo "Check DNS, proxy, and outbound HTTPS access before starting the full verification." >&2
      exit 1
    fi
  done

  for endpoint in "${playwright_cdns[@]}"; do
    if curl "${curl_args[@]}" "$endpoint" >/dev/null 2>&1; then
      playwright_cdn_available=1
      break
    fi
  done
  if (( ! playwright_cdn_available )); then
    echo "Dependency network preflight failed: unable to reach any Playwright Chromium CDN." >&2
    echo "Check DNS, proxy, and outbound HTTPS access before starting the full verification." >&2
    exit 1
  fi

  echo "Dependency network preflight passed."
  echo "Playwright browser CDN preflight passed."
}

preflight() {
  "$ROOT_DIR/scripts/ci/retry-command" "Preflight retry policy" true
  local worktree_status
  if ! worktree_status="$(git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" status --porcelain=v1 --untracked-files=all --ignore-submodules=all)"; then
    echo "Unable to inspect the local verification checkout; use a clean Git checkout of the target revision." >&2
    exit 1
  fi
  if [[ -n "$worktree_status" ]]; then
    echo "The local verification checkout has tracked changes or non-ignored untracked files; use a clean checkout of the target revision." >&2
    printf '%s\n' "$worktree_status" >&2
    exit 1
  fi
  if [[ ! -f "$DOCKERFILE_PATH" ]]; then
    echo "Missing local verification Dockerfile: $DOCKERFILE_PATH" >&2
    exit 1
  fi
  prepare_cache
  docker_access_preflight
  dependency_network_preflight
  SOURCE_REVISION="$(git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" rev-parse HEAD)"
  echo "Verification revision: $SOURCE_REVISION"
}

preflight

if ((PREFLIGHT_ONLY)); then
  echo "Docker preflight passed; no image build or container run requested."
  exit 0
fi

START_SECONDS="$(date +%s)"
remove_verification_snapshot() {
  if [[ -z "$SNAPSHOT_DIR" ]]; then
    return 0
  fi

  if ! git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" worktree remove --force "$SNAPSHOT_DIR" >/dev/null 2>&1; then
    echo "Unable to remove local verification snapshot: $SNAPSHOT_DIR" >&2
    return 1
  fi
  SNAPSHOT_DIR=""
}

report_duration() {
  local status=$?
  trap - EXIT
  if ! remove_verification_snapshot; then
    status=1
  fi
  local elapsed=$(( $(date +%s) - START_SECONDS ))
  echo "Local Docker verification finished with status $status after ${elapsed}s."
  exit "$status"
}
trap report_duration EXIT

create_verification_snapshot() {
  local snapshot_parent="$CACHE_DIR/worktrees"
  local snapshot_path
  local snapshot_revision

  if ! mkdir -p "$snapshot_parent"; then
    echo "Unable to create the local verification snapshot directory: $snapshot_parent" >&2
    return 1
  fi
  if ! snapshot_path="$(mktemp -d "$snapshot_parent/local-verifier.XXXXXX")"; then
    echo "Unable to allocate a local verification snapshot directory under: $snapshot_parent" >&2
    return 1
  fi
  if ! rmdir "$snapshot_path"; then
    echo "Unable to prepare the local verification snapshot path: $snapshot_path" >&2
    return 1
  fi
  if ! git -c "safe.directory=$ROOT_DIR" -C "$ROOT_DIR" worktree add --quiet --detach "$snapshot_path" "$SOURCE_REVISION"; then
    rmdir "$snapshot_path" 2>/dev/null || true
    echo "Unable to create an immutable worktree snapshot for revision $SOURCE_REVISION." >&2
    return 1
  fi
  SNAPSHOT_DIR="$snapshot_path"

  if ! snapshot_revision="$(git -c "safe.directory=$SNAPSHOT_DIR" -C "$SNAPSHOT_DIR" rev-parse HEAD)" ||
    [[ "$snapshot_revision" != "$SOURCE_REVISION" ]]; then
    echo "The local verification snapshot does not match revision $SOURCE_REVISION." >&2
    return 1
  fi
  echo "Verification snapshot: $SNAPSHOT_DIR ($snapshot_revision)"
}

if ! create_verification_snapshot; then
  exit 1
fi

if ! HOST_GROUP_IDS="$(id -G)"; then
  echo "Unable to resolve the invoking user's supplementary groups for the Docker container." >&2
  exit 1
fi
read -r -a HOST_GROUP_ID_ARRAY <<< "$HOST_GROUP_IDS"
SUPPLEMENTARY_GROUP_ARGS=()
PRIMARY_GID="$(id -g)"
for group_id in "${HOST_GROUP_ID_ARRAY[@]}"; do
  if [[ "$group_id" != "$PRIMARY_GID" ]]; then
    SUPPLEMENTARY_GROUP_ARGS+=(--group-add "$group_id")
  fi
done

if ((BUILD_IMAGE)); then
  build_args=(build --tag "$IMAGE_NAME" --file "$SNAPSHOT_DIR/$DOCKERFILE_RELATIVE")
  if ((PULL_IMAGE)); then
    build_args+=(--pull)
  fi
  "$SNAPSHOT_DIR/scripts/ci/retry-command" "Docker image build" "$DOCKER_BIN" "${build_args[@]}" "$SNAPSHOT_DIR"
fi

run_container() {
  "$DOCKER_BIN" run --rm --init \
  --security-opt no-new-privileges:true \
  --user "$(id -u):$(id -g)" \
  "${SUPPLEMENTARY_GROUP_ARGS[@]}" \
  --workdir /workspace \
  --tmpfs /tmp:exec \
  --volume "$SNAPSHOT_DIR:/workspace" \
  --volume "$CACHE_DIR/gradle:/cache/gradle:rw" \
  --volume "$CACHE_DIR/terraform:/cache/terraform:rw" \
  --volume "$CACHE_DIR/flutter:/cache/flutter:rw" \
  --volume "$CACHE_DIR/npm:/cache/npm:rw" \
  --volume "$GIT_COMMON_DIR:$GIT_COMMON_DIR:ro" \
  --env CI=1 \
  --env HOME=/tmp/aet-ci-home \
  --env LOCAL_VERIFIER_RETRY_ATTEMPTS="$RETRY_ATTEMPTS" \
  --env LOCAL_VERIFIER_RETRY_DELAY_SECONDS="$RETRY_DELAY_SECONDS" \
  --env GRADLE_USER_HOME=/cache/gradle \
  --env PUB_CACHE=/cache/flutter/pub-cache \
  --env TF_DATA_DIR=/tmp/aet-terraform-data \
  --env TF_PLUGIN_CACHE_DIR=/cache/terraform/plugin-cache \
  --env TF_PLUGIN_CACHE_LOCK_FILE=/cache/terraform/plugin-cache.lock \
  --env npm_config_cache=/cache/npm \
  --env AWS_ACCESS_KEY_ID= \
  --env AWS_SECRET_ACCESS_KEY= \
  --env AWS_SESSION_TOKEN= \
  --env AWS_SECURITY_TOKEN= \
  --env AWS_PROFILE= \
  --env AWS_CONFIG_FILE=/dev/null \
  --env AWS_SHARED_CREDENTIALS_FILE=/dev/null \
  --env AWS_EC2_METADATA_DISABLED=true \
  "$IMAGE_NAME" \
  bash -euo pipefail -c '
    mkdir -p "$HOME" "$GRADLE_USER_HOME" "$PUB_CACHE" "$TF_DATA_DIR" "$TF_PLUGIN_CACHE_DIR" "$npm_config_cache"
    git config --global --add safe.directory /workspace
    exec ./scripts/ci/verify-local
  '
}

run_container
