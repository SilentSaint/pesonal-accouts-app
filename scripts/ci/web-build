#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
output_dir="$(mktemp -d)"
trap 'rm -rf "$output_dir"' EXIT
cd "$repo_root/frontend"

command -v flutter >/dev/null || { echo "Flutter must be installed for the web build." >&2; exit 1; }
flutter pub get
flutter build web --output "$output_dir"
