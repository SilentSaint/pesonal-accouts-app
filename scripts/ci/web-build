#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root/frontend"

command -v flutter >/dev/null || { echo "Flutter must be installed for the web build." >&2; exit 1; }
flutter pub get
defines=()
if [[ -n "${API_BASE_URL:-}" || -n "${WEBSOCKET_SYNC_URL:-}" ]]; then
  test -n "${API_BASE_URL:-}" && test -n "${WEBSOCKET_SYNC_URL:-}" || {
    echo "Both release endpoints are required for a configured web build." >&2
    exit 1
  }
  defines+=(--dart-define=API_BASE_URL="$API_BASE_URL" --dart-define=WEBSOCKET_SYNC_URL="$WEBSOCKET_SYNC_URL")
fi
flutter build web --release "${defines[@]}"
node "$repo_root/scripts/release_artifacts.js" snapshot "$repo_root" web
